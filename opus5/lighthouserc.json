{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/training/index.html",
        "http://localhost/training/dogwalking/index.html",
        "http://localhost/training/spuerhunde/index.html",
        "http://localhost/shop/index.html",
        "http://localhost/shop/halsbaender/index.html",
        "http://localhost/ernaehrung/index.html",
        "http://localhost/ueber-uns/index.html",
        "http://localhost/kundenstimmen/index.html",
        "http://localhost/galerie/index.html",
        "http://localhost/kontakt/index.html"
      ],
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 1600000 }],
        "unused-css-rules": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
